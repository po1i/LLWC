---
// Visible marker for anything the owner still has to supply.
interface Props { label: string }
const { label } = Astro.props;
---
<mark class="ph" title="Placeholder: replace before launch">[[PLACEHOLDER: {label}]]</mark>

<style>
  .ph {
    display: inline;
    padding: 0.05em 0.35em;
    border: 1px dashed var(--control);
    border-radius: 2px;
    background: transparent;
    color: var(--graphite);
    font-family: var(--f-ui);
    font-size: 0.78em;
    font-style: normal;
    font-variant: normal;
    letter-spacing: 0;
    white-space: normal;
  }
</style>

---
const stats = [
  { value: '3.4×', label: 'Average return on ad spend across managed accounts' },
  { value: '41%', label: 'Lower cost per lead after the first 90 days' },
  { value: '12 min', label: 'Of your time per week. That is the whole ask.' },
];
const quotes = [
  {
    text: 'First agency that told me what they were doing in words I understood. Bookings doubled in a quarter and I stopped checking the ads app at midnight.',
    name: 'Dana Whitfield',
    role: 'Owner, Northline Dental',
  },
  {
    text: 'The weekly email is the only marketing report I have ever read all the way through.',
    name: 'Marcus Vane',
    role: 'Director, Vane & Sons Roofing',
  },
  {
    text: 'We tried the Platform on its own first. Budget alerts alone saved us more than the subscription in month one.',
    name: 'Priya Rao',
    role: 'Co-founder, Saltbox Café',
  },
];
---

<section class="section proof" id="proof" aria-labelledby="proof-title">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="label" data-reveal>Results</p>
        <h2 id="proof-title" class="display" data-reveal style="--i:1">
          Numbers first. <em>Then the nice words.</em>
        </h2>
      </div>
    </div>

    <ul class="stats">
      {stats.map((s, i) => (
        <li class="stat" data-reveal style={`--i:${i + 1}`}>
          <strong class="display">{s.value}</strong>
          <span>{s.label}</span>
        </li>
      ))}
    </ul>

    <ul class="quotes">
      {quotes.map((q, i) => (
        <li class="quote" data-reveal style={`--i:${i + 1}`}>
          <blockquote>
            <p>“{q.text}”</p>
          </blockquote>
          <footer>
            <strong>{q.name}</strong>
            <span>{q.role}</span>
          </footer>
        </li>
      ))}
    </ul>

    <p class="proof-after" data-reveal>
      <a href="#book" class="link">See if we are a fit</a>
    </p>
  </div>
</section>

<style>
  .stats {
    display: grid;
    gap: 2rem;
    padding-block: 2rem;
    border-block: 1px solid var(--line);
  }
  @media (min-width: 48rem) { .stats { grid-template-columns: repeat(3, 1fr); } }
  .stat strong { display: block; font-weight: 300; font-size: var(--t-1); color: var(--brass); margin-bottom: 0.5rem; }
  .stat span { display: block; color: var(--ink-2); font-size: var(--t-small); max-width: 28ch; line-height: 1.5; }

  .quotes { display: grid; gap: 1px; margin-top: 1px; background: var(--line); }
  @media (min-width: 56rem) { .quotes { grid-template-columns: repeat(3, 1fr); } }
  .quote {
    background: var(--bg);
    padding: clamp(1.5rem, 3vw, 2.5rem) 0;
    display: grid;
    gap: 1.5rem;
    align-content: space-between;
  }
  @media (min-width: 56rem) {
    .quote { padding-inline: clamp(1.5rem, 3vw, 2.5rem); }
    .quote:first-child { padding-left: 0; }
    .quote:last-child { padding-right: 0; }
  }
  blockquote p {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--t-3);
    line-height: 1.35;
    text-wrap: pretty;
  }
  .quote footer { display: grid; font-size: var(--t-small); }
  .quote footer strong { font-weight: 500; }
  .quote footer span { color: var(--ink-3); }

  .proof-after { margin-top: 2.5rem; }
</style>

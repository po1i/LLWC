---
const lines = [
  'You have boosted a post, watched the money go, and learned nothing.',
  'Every agency promised a strategy. You got a monthly PDF and a bigger invoice.',
  'You want customers, not another dashboard you have to learn.',
];
---

<section class="section pain" aria-labelledby="pain-title">
  <div class="wrap">
    <h2 id="pain-title" class="label" data-reveal>Sound familiar</h2>
    <ol class="pain-list">
      {lines.map((l, i) => (
        <li class="display" data-reveal style={`--i:${i + 1}`}>
          <span class="num" aria-hidden="true">0{i + 1}</span>
          {l}
        </li>
      ))}
    </ol>
    <p class="pain-after lede" data-reveal>
      We built LLWC for owners who are tired of the above. Here is exactly what you are buying.
      <a href="#offer" class="link">Read on</a>
    </p>
  </div>
</section>

<style>
  .pain-list { display: grid; gap: clamp(1.5rem, 3vw, 2.5rem); margin-top: 2.5rem; }
  .pain-list li {
    font-size: var(--t-1);
    max-width: 22ch;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1rem, 3vw, 2rem);
    align-items: baseline;
  }
  .num {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: 0.14em;
    color: var(--brass);
    padding-top: 0.4em;
  }
  .pain-after {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    align-items: center;
  }
</style>

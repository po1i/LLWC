---

const lines = [
  'You boosted a post for injectables week. It got likes, not consults.',
  'Saturdays book themselves. Tuesday afternoons sit empty.',
  'An agency sent a monthly report. You still can’t tell which ad booked which patient.',
];
---

<section class="section pain" aria-labelledby="pain-title">
  <div class="wrap">
    <h2 id="pain-title" class="pain-title" data-reveal>Where it usually goes wrong</h2>
    <ol class="pain-list">
      {lines.map((l, i) => (
        <li class="display" data-reveal style={`--i:${i + 1}`}>
          {l}
        </li>
      ))}
    </ol>
    <p class="pain-after lede" data-reveal>
      If any of that sounds like your spa, here’s what I’d do about it.
      <a href="#offer" class="link">See the plan <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
    </p>
  </div>
</section>

<style>
  .pain-list { display: grid; gap: clamp(1.5rem, 3vw, 2.5rem); margin-top: 2.5rem; }
  .pain-list li {
    font-size: var(--t-1);
    max-width: 24ch;
    padding-left: clamp(1rem, 3vw, 2rem);
    border-left: 1px solid rgb(201 166 107 / 0.45);
  }
  .pain-list li:nth-child(2) { margin-left: clamp(0rem, 8vw, 8rem); }
  .pain-list li:nth-child(3) { margin-left: clamp(0rem, 4vw, 4rem); }
  .pain-title {
    font-size: var(--t-small);
    font-weight: 500;
    color: var(--ink-2);
  }
  .pain-after {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    align-items: center;
  }
</style>

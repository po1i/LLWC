---
import { site } from '../data/site';

const lines = [
  'You boosted a post for injectables week. It got likes, not consults.',
  'Saturdays book themselves. Tuesday afternoons sit empty.',
  'An agency sent a monthly report. You still can’t tell which ad booked which patient.',
];
---

<section class="section pain" aria-labelledby="pain-title">
  <div class="wrap">
    <h2 id="pain-title" class="label" data-reveal>Sound familiar</h2>
    <ol class="pain-list">
      {lines.map((l, i) => (
        <li class="display" data-reveal style={`--i:${i + 1}`}>
          <span class="num" aria-hidden="true">0{i + 1}</span>
          {l}
        </li>
      ))}
    </ol>
    <p class="pain-after lede" data-reveal>
      {site.brand} is for med spa owners who are done with all three. Here is exactly what you
      are buying.
      <a href="#offer" class="link">Read on <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
    </p>
  </div>
</section>

<style>
  .pain-list { display: grid; gap: clamp(1.5rem, 3vw, 2.5rem); margin-top: 2.5rem; }
  .pain-list li {
    font-size: var(--t-1);
    max-width: 24ch;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1rem, 3vw, 2rem);
    align-items: baseline;
  }
  .num {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: 0.14em;
    color: var(--brass);
    padding-top: 0.4em;
  }
  .pain-after {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    align-items: center;
  }
</style>

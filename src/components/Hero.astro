---
import { site } from '../data/site';
import Btn from './Btn.astro';

const { founder } = site;
const photoSrc = founder.photo ? `${import.meta.env.BASE_URL}${founder.photo}` : null;
---

<section class="hero" id="top">
  <div class="hero-bg" aria-hidden="true" data-hero-bg>
    <div class="hero-glow"></div>
    <canvas class="hero-canvas" data-hero-canvas></canvas>
  </div>
  <div class="wrap hero-inner">
    <p class="label" data-reveal>Facebook &amp; Instagram ads for med spas</p>
    <h1 class="display hero-title" data-reveal style="--i:1">
      New patients for <em><span class="nowrap">Boston-area</span> <span class="nowrap">med spas.</span></em>
    </h1>
    <p class="lede hero-lede" data-reveal style="--i:2">
      I set up and run three things for you: Meta ads, a booking-ready landing page, and
      tracking that shows which ads turn into booked consults. You stay with your patients.
    </p>
    <div class="hero-actions" data-reveal style="--i:3">
      <Btn href="#book" label="Book a 20-minute call" />
      <Btn href="#offer" label="See what you get" variant="ghost" />
    </div>

    <div class="founder" data-reveal style="--i:4">
      {photoSrc ? (
        <img class="founder-photo" src={photoSrc} alt={`${founder.name}, ${founder.role} of ${site.legalName}`} width="56" height="56" loading="eager" decoding="async" />
      ) : (
        <div class="founder-photo founder-photo--tbd" role="img" aria-label={`Placeholder for a photo of ${founder.name}`} title="Placeholder: founder photo">
          <span aria-hidden="true">{founder.name.charAt(0)}</span>
        </div>
      )}
      <p class="founder-text">
        <strong>{founder.name}</strong>
        <span>{founder.role}, {site.legalName}</span>
      </p>
      <p class="founder-city">
        <span class="pin" aria-hidden="true"></span>
        Based in {founder.city}
      </p>
    </div>
  </div>
</section>

<script>
  import { initHeroShader } from '../scripts/hero-shader';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  const layer = document.querySelector<HTMLElement>('[data-hero-bg]');
  // Start after the page has painted so the shader never competes with the headline (LCP).
  const start = () => canvas && layer && initHeroShader(canvas, layer);
  const idle = (cb: () => void) =>
    'requestIdleCallback' in window ? requestIdleCallback(cb, { timeout: 1200 }) : setTimeout(cb, 200);
  if (document.readyState === 'complete') idle(start);
  else window.addEventListener('load', () => idle(start), { once: true });
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    padding-block: clamp(7rem, 15vh, 10rem) clamp(2rem, 5vh, 4rem);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    will-change: transform, opacity;
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.6s var(--ease-out);
  }
  .hero-canvas:global(.is-ready) { opacity: 1; }

  /* Fallback light when WebGL is unavailable; the canvas covers it once ready. */
  .hero-glow {
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 90%;
    background:
      radial-gradient(60% 55% at 70% 30%, rgb(201 166 107 / 0.16), transparent 70%),
      radial-gradient(45% 45% at 25% 70%, rgb(201 166 107 / 0.07), transparent 70%);
    filter: blur(20px);
    pointer-events: none;
  }

  .hero-inner { position: relative; display: grid; gap: 1.75rem; }

  .hero-title {
    font-size: var(--t-hero);
    max-width: 14ch;
  }
  .nowrap { white-space: nowrap; }

  .hero-lede { font-size: var(--t-3); line-height: 1.5; max-width: 46ch; }

  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }

  .founder {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: clamp(1.5rem, 4vh, 3rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .founder-photo {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
    box-shadow: 0 0 0 1px var(--line-strong);
  }
  .founder-photo--tbd {
    display: grid;
    place-items: center;
    background: var(--surface-2);
    border: 1px dashed rgb(201 166 107 / 0.6);
    box-shadow: none;
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--brass);
  }
  .founder-text { display: grid; line-height: 1.35; }
  .founder-text strong { font-weight: 500; }
  .founder-text span { color: var(--ink-3); font-size: var(--t-small); }

  .founder-city {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .pin {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--brass);
    box-shadow: 0 0 0 4px var(--brass-dim);
  }
  @media (max-width: 30rem) {
    .founder-city { margin-left: 0; flex-basis: 100%; }
  }
</style>

---
const arrow = `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>`;
---

<section class="hero" id="top">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="wrap hero-inner">
    <p class="label" data-reveal>Managed ads · Lightweight software</p>
    <h1 class="display hero-title" data-reveal style="--i:1">
      Ads that pay for themselves.<br />
      Software that <em>runs them.</em>
    </h1>
    <p class="lede hero-lede" data-reveal style="--i:2">
      You did not start a business to babysit ad campaigns. We plan, build and run your
      social advertising, and give you one calm dashboard to see what it is doing. No jargon,
      no surprises on the invoice.
    </p>
    <div class="hero-actions" data-reveal style="--i:3">
      <a href="#book" class="btn btn-primary">Book a 20-minute call <Fragment set:html={arrow} /></a>
      <a href="#offer" class="btn btn-ghost">See what you get</a>
    </div>

    <ul class="logos" aria-label="Trusted by" data-reveal style="--i:4">
      {['Northline Dental', 'Hollow Oak Co.', 'Vane & Sons', 'Marrow Fitness', 'Saltbox Café'].map((n) => (
        <li>{n}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    padding-block: clamp(8rem, 18vh, 12rem) clamp(3rem, 8vh, 6rem);
    overflow: hidden;
  }

  /* Placeholder for the WebGL silk shader (next round). */
  .hero-glow {
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 90%;
    background:
      radial-gradient(60% 55% at 70% 30%, rgb(201 166 107 / 0.16), transparent 70%),
      radial-gradient(45% 45% at 25% 70%, rgb(201 166 107 / 0.07), transparent 70%);
    filter: blur(20px);
    pointer-events: none;
  }

  .hero-inner { position: relative; display: grid; gap: 1.75rem; }

  .hero-title {
    font-size: var(--t-hero);
    max-width: 14ch;
  }

  .hero-lede { font-size: var(--t-3); line-height: 1.5; max-width: 46ch; }

  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }

  .logos {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin-top: clamp(2rem, 6vh, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1rem;
    color: var(--ink-3);
    letter-spacing: 0.01em;
  }
</style>

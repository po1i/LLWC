---
const faqs = [
  { q: 'How much should I budget for ad spend?', a: 'Most owners start between $1,000 and $3,000 a month. On the first call we work backwards from what a customer is worth to you and tell you a number. If that number does not make sense for your margins, we will say so.' },
  { q: 'Do I need both Managed Ads and the Platform?', a: 'No. Managed Ads includes the Platform. If you want to run ads yourself, the Platform on its own is enough.' },
  { q: 'Is there a contract?', a: 'Month to month. Give us 14 days notice to stop. Your ad accounts and all the creative stay yours.' },
  { q: 'How fast will I see results?', a: 'Campaigns go live within two weeks of the plan being approved. Expect the first two to four weeks to be learning, then a clear trend by the end of month two. We tell you the honest timeline on the call.' },
  { q: 'Which platforms do you run ads on?', a: 'Meta (Facebook and Instagram), TikTok and Google. We pick based on where your customers are, not where we have a preference.' },
];
---

<section class="section faq" id="faq" aria-labelledby="faq-title">
  <div class="wrap faq-grid">
    <div>
      <p class="label" data-reveal>Questions</p>
      <h2 id="faq-title" class="display" data-reveal style="--i:1">
        Asked by <em>every owner</em> we talk to.
      </h2>
    </div>
    <div class="faq-list">
      {faqs.map((f, i) => (
        <details class="faq-item" data-reveal style={`--i:${i + 1}`} name="faq">
          <summary>
            <span>{f.q}</span>
            <span class="faq-icon" aria-hidden="true"></span>
          </summary>
          <div class="faq-body"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-grid { display: grid; gap: 2.5rem; }
  @media (min-width: 56rem) { .faq-grid { grid-template-columns: 5fr 7fr; gap: clamp(3rem, 8vw, 8rem); } }
  .faq-grid .display { font-size: var(--t-1); margin-top: 1.25rem; max-width: 12ch; }

  .faq-item { border-top: 1px solid var(--line); }
  .faq-item:last-child { border-bottom: 1px solid var(--line); }
  summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1.4rem 0;
    cursor: pointer;
    font-size: var(--t-3);
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.3;
    transition: color 0.25s var(--ease-out);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--brass-2); }
  summary:focus-visible { outline-offset: -2px; }

  .faq-icon {
    position: relative;
    flex: 0 0 1.5rem;
    width: 1.5rem; height: 1.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
  }
  .faq-icon::before, .faq-icon::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 0.6rem; height: 1px;
    background: currentColor;
    translate: -50% -50%;
    transition: rotate 0.4s var(--ease-out);
  }
  .faq-icon::after { rotate: 90deg; }
  details[open] .faq-icon::after { rotate: 0deg; }

  .faq-body { padding-bottom: 1.5rem; color: var(--ink-2); max-width: 60ch; line-height: 1.6; }
  .faq-body p { text-wrap: pretty; }

  @media (prefers-reduced-motion: reduce) { .faq-icon::before, .faq-icon::after { transition: none; } }
</style>

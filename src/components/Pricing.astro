---
import Tbd from './Tbd.astro';
import Btn from './Btn.astro';
import { site, usd } from '../data/site';
const { price, terms } = site;

const tiers = [
  {
    name: 'Growth',
    price: usd(price.growth),
    per: `per month + ad spend (min ${usd(price.adSpendMin)}, paid to Meta)`,
    blurb: 'Ads, landing page and tracking, set up and run for you.',
    features: [
      `Booking-ready landing page, yours after ${price.ownershipPayments} payments`,
      'Facebook and Instagram campaigns, built and run',
      '8–12 new ad creatives a month',
      'Review requests in your booking software',
      'Weekly email and monthly 20-minute call',
    ],
    cta: 'Book a call',
    founding: false,
  },
  {
    name: 'Founding',
    price: usd(price.founding),
    per: `per month for ${price.foundingMonths} months, then ${usd(price.growth)}`,
    blurb: 'The full Growth plan at a lower rate for the first three med spas.',
    features: [
      'Everything in Growth, same scope',
      `${usd(price.founding)} a month for your first ${price.foundingMonths} months`,
      'In return: a case study and a testimonial',
      'Plus permission to mention your spa by name',
    ],
    cta: 'Ask about a founding spot',
    founding: true,
  },
];
---

<section class="section pricing" id="pricing" aria-labelledby="pricing-title">
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2 id="pricing-title" class="display" data-reveal>
          A flat monthly fee, never a percentage of spend
        </h2>
      </div>
      <p class="lede" data-reveal style="--i:2">
        Agencies that take a cut of your ad spend make more when you spend more. I’d rather be
        paid for results. There’s a {terms.minimumMonths}-month minimum, then it’s month to month with
        {terms.noticePeriod ?? <Tbd label="notice period" />} written notice.
      </p>
    </div>

    <div class="tiers">
      {tiers.map((t, i) => (
        <article class:list={['tier', { founding: t.founding }]} data-reveal style={`--i:${i + 1}`}>
          {t.founding && <p class="tier-flag">{price.foundingSpots} spots</p>}
          <h3 class="tier-name">{t.name}</h3>
          <p class="tier-price">
            <span class="display">{t.price}</span>
            <span class="tier-per">{t.per}</span>
          </p>
          <p class="tier-blurb">{t.blurb}</p>
          <ul class="tier-features">
            {t.features.map((f) => <li>{f}</li>)}
          </ul>
          <Btn href="#book" label={t.cta} variant={t.founding ? 'primary' : 'ghost'} full class="tier-cta" />
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .tiers { display: grid; gap: 1.5rem; }
  @media (min-width: 52rem) { .tiers { grid-template-columns: repeat(2, 1fr); align-items: stretch; } }

  .tier {
    position: relative;
    display: grid;
    gap: 1.25rem;
    align-content: start;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-2);
    transition: border-color 0.4s var(--ease-out);
  }
  .tier:hover { border-color: var(--line-strong); }
  .tier.founding { background: var(--surface); border-color: rgb(201 166 107 / 0.45); }
  .tier.founding:hover { border-color: var(--brass); }

  .tier-flag {
    position: absolute;
    top: -0.75rem; left: 1.5rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: var(--brass);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tier-name { font-size: var(--t-small); font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-2); }
  .tier-price { display: grid; gap: 0.35rem; }
  .tier-price .display { font-size: var(--t-1); }
  .tier-per { font-family: var(--font-mono); font-size: var(--t-label); color: var(--ink-3); letter-spacing: 0.04em; line-height: 1.5; }
  .tier-blurb { color: var(--ink-2); font-size: var(--t-small); line-height: 1.5; }

  .tier-features {
    display: grid;
    gap: 0.6rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: var(--t-small);
    color: var(--ink-2);
  }
  .tier-features li { display: grid; grid-template-columns: 0.75rem 1fr; gap: 0.75rem; align-items: baseline; line-height: 1.5; }
  .tier-features li::before { content: ''; width: 0.4rem; height: 0.4rem; border-radius: 50%; background: var(--brass); }

  .tier :global(.tier-cta) { margin-top: 0.5rem; }
</style>

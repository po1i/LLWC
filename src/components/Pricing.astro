---
const tiers = [
  {
    name: 'Platform',
    price: '$49',
    per: 'per month',
    blurb: 'Run your own ads with the dashboard, alerts and weekly summary.',
    features: ['Unlimited ad accounts', 'Budget pacing alerts', 'Weekly plain-language email', 'Email support, same day'],
    cta: 'Start free for 14 days',
    featured: false,
  },
  {
    name: 'Managed',
    price: '$1,500',
    per: 'per month + ad spend',
    blurb: 'We run everything. You read a short email once a week.',
    features: ['Everything in Platform', 'Strategy, creative and copy', 'Campaigns built and optimised', '15-minute weekly call', 'Landing page tune-ups'],
    cta: 'Book a call',
    featured: true,
  },
  {
    name: 'Managed Plus',
    price: '$3,500',
    per: 'per month + ad spend',
    blurb: 'For multi-location or multi-brand owners who need more hands.',
    features: ['Everything in Managed', 'Up to 3 brands or locations', 'Monthly creative refresh', 'Quarterly strategy review', 'Priority support'],
    cta: 'Book a call',
    featured: false,
  },
];
---

<section class="section pricing" id="pricing" aria-labelledby="pricing-title">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="label" data-reveal>Pricing</p>
        <h2 id="pricing-title" class="display" data-reveal style="--i:1">
          Flat fees. <em>No percentage of spend.</em>
        </h2>
      </div>
      <p class="lede" data-reveal style="--i:2">
        Agencies that charge a cut of your ad spend are paid to spend more. We are paid to make it
        work. Month to month, no lock-in.
      </p>
    </div>

    <div class="tiers">
      {tiers.map((t, i) => (
        <article class:list={['tier', { featured: t.featured }]} data-reveal style={`--i:${i + 1}`}>
          {t.featured && <p class="tier-flag">Most owners choose this</p>}
          <h3 class="tier-name">{t.name}</h3>
          <p class="tier-price">
            <span class="display">{t.price}</span>
            <span class="tier-per">{t.per}</span>
          </p>
          <p class="tier-blurb">{t.blurb}</p>
          <ul class="tier-features">
            {t.features.map((f) => <li>{f}</li>)}
          </ul>
          <a href="#book" class:list={['btn', t.featured ? 'btn-primary' : 'btn-ghost']}>{t.cta}</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .tiers { display: grid; gap: 1rem; }
  @media (min-width: 60rem) { .tiers { grid-template-columns: repeat(3, 1fr); align-items: stretch; } }

  .tier {
    position: relative;
    display: grid;
    gap: 1.25rem;
    align-content: start;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-2);
    transition: border-color 0.4s var(--ease-out), transform 0.5s var(--ease-out);
  }
  .tier:hover { border-color: var(--line-strong); }
  .tier.featured { background: var(--surface); border-color: rgb(201 166 107 / 0.45); }
  @media (min-width: 60rem) { .tier.featured { transform: translateY(-0.5rem); } }

  .tier-flag {
    position: absolute;
    top: -0.75rem; left: 1.5rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: var(--brass);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tier-name { font-size: var(--t-small); font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-2); }
  .tier-price { display: grid; gap: 0.25rem; }
  .tier-price .display { font-size: var(--t-1); }
  .tier-per { font-family: var(--font-mono); font-size: var(--t-label); color: var(--ink-3); letter-spacing: 0.06em; }
  .tier-blurb { color: var(--ink-2); font-size: var(--t-small); line-height: 1.5; }

  .tier-features {
    display: grid;
    gap: 0.6rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: var(--t-small);
    color: var(--ink-2);
  }
  .tier-features li { display: grid; grid-template-columns: 0.75rem 1fr; gap: 0.75rem; align-items: baseline; }
  .tier-features li::before { content: ''; width: 0.4rem; height: 0.4rem; border-radius: 50%; background: var(--brass); }

  .tier .btn { justify-content: center; margin-top: 0.5rem; }
</style>
